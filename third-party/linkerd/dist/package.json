{
  "name": "@kubernetes-models/linkerd",
  "version": "0.4.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/tommy351/kubernetes-models-ts.git"
  },
  "homepage": "https://github.com/tommy351/kubernetes-models-ts/tree/master/third-party/linkerd",
  "author": "YC Kao <yckaokarl@gmail.com>",
  "license": "MIT",
  "main": "index.js",
  "module": "index.mjs",
  "types": "index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "ts-node scripts/download-crd.ts && crd-generate && publish-scripts build",
    "prepack": "publish-scripts prepack"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist",
    "linkDirectory": true
  },
  "keywords": [
    "kubernetes",
    "kubernetes-models",
    "linkerd"
  ],
  "engines": {
    "node": ">=14"
  },
  "dependencies": {
    "@kubernetes-models/apimachinery": "workspace:^",
    "@kubernetes-models/base": "workspace:^",
    "@kubernetes-models/validate": "workspace:^",
    "@swc/helpers": "^0.5.8"
  },
  "devDependencies": {
    "@kubernetes-models/crd-generate": "workspace:^",
    "@kubernetes-models/publish-scripts": "workspace:^",
    "@kubernetes-models/read-input": "workspace:^",
    "@types/js-yaml": "^4.0.5",
    "@types/node": "^18.7.23",
    "execa": "^5.1.1",
    "js-yaml": "^4.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^4.8.4",
    "vitest": "^0.29.8"
  },
  "crd-generate": {
    "input": [
      "./crds/crd.yaml"
    ],
    "output": "./gen"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./linkerd.io": {
      "types": "./linkerd.io/index.d.ts",
      "import": "./linkerd.io/index.mjs",
      "require": "./linkerd.io/index.js"
    },
    "./linkerd.io/v1alpha1": {
      "types": "./linkerd.io/v1alpha1/index.d.ts",
      "import": "./linkerd.io/v1alpha1/index.mjs",
      "require": "./linkerd.io/v1alpha1/index.js"
    },
    "./linkerd.io/v1alpha1/*": {
      "types": "./linkerd.io/v1alpha1/*.d.ts",
      "import": "./linkerd.io/v1alpha1/*.mjs",
      "require": "./linkerd.io/v1alpha1/*.js"
    },
    "./linkerd.io/v1alpha2": {
      "types": "./linkerd.io/v1alpha2/index.d.ts",
      "import": "./linkerd.io/v1alpha2/index.mjs",
      "require": "./linkerd.io/v1alpha2/index.js"
    },
    "./linkerd.io/v1alpha2/*": {
      "types": "./linkerd.io/v1alpha2/*.d.ts",
      "import": "./linkerd.io/v1alpha2/*.mjs",
      "require": "./linkerd.io/v1alpha2/*.js"
    },
    "./multicluster.linkerd.io": {
      "types": "./multicluster.linkerd.io/index.d.ts",
      "import": "./multicluster.linkerd.io/index.mjs",
      "require": "./multicluster.linkerd.io/index.js"
    },
    "./multicluster.linkerd.io/v1alpha1": {
      "types": "./multicluster.linkerd.io/v1alpha1/index.d.ts",
      "import": "./multicluster.linkerd.io/v1alpha1/index.mjs",
      "require": "./multicluster.linkerd.io/v1alpha1/index.js"
    },
    "./multicluster.linkerd.io/v1alpha1/*": {
      "types": "./multicluster.linkerd.io/v1alpha1/*.d.ts",
      "import": "./multicluster.linkerd.io/v1alpha1/*.mjs",
      "require": "./multicluster.linkerd.io/v1alpha1/*.js"
    },
    "./multicluster.linkerd.io/v1alpha2": {
      "types": "./multicluster.linkerd.io/v1alpha2/index.d.ts",
      "import": "./multicluster.linkerd.io/v1alpha2/index.mjs",
      "require": "./multicluster.linkerd.io/v1alpha2/index.js"
    },
    "./multicluster.linkerd.io/v1alpha2/*": {
      "types": "./multicluster.linkerd.io/v1alpha2/*.d.ts",
      "import": "./multicluster.linkerd.io/v1alpha2/*.mjs",
      "require": "./multicluster.linkerd.io/v1alpha2/*.js"
    },
    "./package.json": "./package.json",
    "./policy.linkerd.io": {
      "types": "./policy.linkerd.io/index.d.ts",
      "import": "./policy.linkerd.io/index.mjs",
      "require": "./policy.linkerd.io/index.js"
    },
    "./policy.linkerd.io/v1alpha1": {
      "types": "./policy.linkerd.io/v1alpha1/index.d.ts",
      "import": "./policy.linkerd.io/v1alpha1/index.mjs",
      "require": "./policy.linkerd.io/v1alpha1/index.js"
    },
    "./policy.linkerd.io/v1alpha1/*": {
      "types": "./policy.linkerd.io/v1alpha1/*.d.ts",
      "import": "./policy.linkerd.io/v1alpha1/*.mjs",
      "require": "./policy.linkerd.io/v1alpha1/*.js"
    },
    "./policy.linkerd.io/v1beta1": {
      "types": "./policy.linkerd.io/v1beta1/index.d.ts",
      "import": "./policy.linkerd.io/v1beta1/index.mjs",
      "require": "./policy.linkerd.io/v1beta1/index.js"
    },
    "./policy.linkerd.io/v1beta1/*": {
      "types": "./policy.linkerd.io/v1beta1/*.d.ts",
      "import": "./policy.linkerd.io/v1beta1/*.mjs",
      "require": "./policy.linkerd.io/v1beta1/*.js"
    },
    "./policy.linkerd.io/v1beta2": {
      "types": "./policy.linkerd.io/v1beta2/index.d.ts",
      "import": "./policy.linkerd.io/v1beta2/index.mjs",
      "require": "./policy.linkerd.io/v1beta2/index.js"
    },
    "./policy.linkerd.io/v1beta2/*": {
      "types": "./policy.linkerd.io/v1beta2/*.d.ts",
      "import": "./policy.linkerd.io/v1beta2/*.mjs",
      "require": "./policy.linkerd.io/v1beta2/*.js"
    },
    "./policy.linkerd.io/v1beta3": {
      "types": "./policy.linkerd.io/v1beta3/index.d.ts",
      "import": "./policy.linkerd.io/v1beta3/index.mjs",
      "require": "./policy.linkerd.io/v1beta3/index.js"
    },
    "./policy.linkerd.io/v1beta3/*": {
      "types": "./policy.linkerd.io/v1beta3/*.d.ts",
      "import": "./policy.linkerd.io/v1beta3/*.mjs",
      "require": "./policy.linkerd.io/v1beta3/*.js"
    },
    "./workload.linkerd.io": {
      "types": "./workload.linkerd.io/index.d.ts",
      "import": "./workload.linkerd.io/index.mjs",
      "require": "./workload.linkerd.io/index.js"
    },
    "./workload.linkerd.io/v1alpha1": {
      "types": "./workload.linkerd.io/v1alpha1/index.d.ts",
      "import": "./workload.linkerd.io/v1alpha1/index.mjs",
      "require": "./workload.linkerd.io/v1alpha1/index.js"
    },
    "./workload.linkerd.io/v1alpha1/*": {
      "types": "./workload.linkerd.io/v1alpha1/*.d.ts",
      "import": "./workload.linkerd.io/v1alpha1/*.mjs",
      "require": "./workload.linkerd.io/v1alpha1/*.js"
    },
    "./workload.linkerd.io/v1beta1": {
      "types": "./workload.linkerd.io/v1beta1/index.d.ts",
      "import": "./workload.linkerd.io/v1beta1/index.mjs",
      "require": "./workload.linkerd.io/v1beta1/index.js"
    },
    "./workload.linkerd.io/v1beta1/*": {
      "types": "./workload.linkerd.io/v1beta1/*.d.ts",
      "import": "./workload.linkerd.io/v1beta1/*.mjs",
      "require": "./workload.linkerd.io/v1beta1/*.js"
    }
  }
}
