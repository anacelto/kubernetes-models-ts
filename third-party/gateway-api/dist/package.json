{
  "name": "@kubernetes-models/gateway-api",
  "version": "0.7.2",
  "description": "Gateway API models",
  "repository": {
    "type": "git",
    "url": "https://github.com/tommy351/kubernetes-models-ts.git"
  },
  "homepage": "https://github.com/tommy351/kubernetes-models-ts/tree/master/third-party/gateway-api",
  "author": "Tommy Chen <tommy351@gmail.com",
  "license": "MIT",
  "main": "index.js",
  "module": "index.mjs",
  "types": "index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "crd-generate && publish-scripts build",
    "prepack": "publish-scripts prepack"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist",
    "linkDirectory": true
  },
  "keywords": [
    "kubernetes",
    "kubernetes-models",
    "gateway-api"
  ],
  "engines": {
    "node": ">=14"
  },
  "dependencies": {
    "@kubernetes-models/apimachinery": "workspace:^",
    "@kubernetes-models/base": "workspace:^",
    "@kubernetes-models/validate": "workspace:^",
    "@swc/helpers": "^0.5.8"
  },
  "devDependencies": {
    "@kubernetes-models/crd-generate": "workspace:^",
    "@kubernetes-models/publish-scripts": "workspace:^",
    "vitest": "^0.29.8"
  },
  "crd-generate": {
    "input": [
      "https://github.com/kubernetes-sigs/gateway-api/releases/download/v0.6.2/standard-install.yaml",
      "https://github.com/kubernetes-sigs/gateway-api/releases/download/v1.0.0/standard-install.yaml",
      "https://github.com/kubernetes-sigs/gateway-api/releases/download/v1.0.0/experimental-install.yaml",
      "https://github.com/kubernetes-sigs/gateway-api/releases/download/v1.2.0/standard-install.yaml",
      "https://github.com/kubernetes-sigs/gateway-api/releases/download/v1.2.0/experimental-install.yaml"
    ],
    "output": "./gen"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./gateway.networking.k8s.io": {
      "types": "./gateway.networking.k8s.io/index.d.ts",
      "import": "./gateway.networking.k8s.io/index.mjs",
      "require": "./gateway.networking.k8s.io/index.js"
    },
    "./gateway.networking.k8s.io/v1": {
      "types": "./gateway.networking.k8s.io/v1/index.d.ts",
      "import": "./gateway.networking.k8s.io/v1/index.mjs",
      "require": "./gateway.networking.k8s.io/v1/index.js"
    },
    "./gateway.networking.k8s.io/v1/*": {
      "types": "./gateway.networking.k8s.io/v1/*.d.ts",
      "import": "./gateway.networking.k8s.io/v1/*.mjs",
      "require": "./gateway.networking.k8s.io/v1/*.js"
    },
    "./gateway.networking.k8s.io/v1alpha2": {
      "types": "./gateway.networking.k8s.io/v1alpha2/index.d.ts",
      "import": "./gateway.networking.k8s.io/v1alpha2/index.mjs",
      "require": "./gateway.networking.k8s.io/v1alpha2/index.js"
    },
    "./gateway.networking.k8s.io/v1alpha2/*": {
      "types": "./gateway.networking.k8s.io/v1alpha2/*.d.ts",
      "import": "./gateway.networking.k8s.io/v1alpha2/*.mjs",
      "require": "./gateway.networking.k8s.io/v1alpha2/*.js"
    },
    "./gateway.networking.k8s.io/v1alpha3": {
      "types": "./gateway.networking.k8s.io/v1alpha3/index.d.ts",
      "import": "./gateway.networking.k8s.io/v1alpha3/index.mjs",
      "require": "./gateway.networking.k8s.io/v1alpha3/index.js"
    },
    "./gateway.networking.k8s.io/v1alpha3/*": {
      "types": "./gateway.networking.k8s.io/v1alpha3/*.d.ts",
      "import": "./gateway.networking.k8s.io/v1alpha3/*.mjs",
      "require": "./gateway.networking.k8s.io/v1alpha3/*.js"
    },
    "./gateway.networking.k8s.io/v1beta1": {
      "types": "./gateway.networking.k8s.io/v1beta1/index.d.ts",
      "import": "./gateway.networking.k8s.io/v1beta1/index.mjs",
      "require": "./gateway.networking.k8s.io/v1beta1/index.js"
    },
    "./gateway.networking.k8s.io/v1beta1/*": {
      "types": "./gateway.networking.k8s.io/v1beta1/*.d.ts",
      "import": "./gateway.networking.k8s.io/v1beta1/*.mjs",
      "require": "./gateway.networking.k8s.io/v1beta1/*.js"
    },
    "./package.json": "./package.json"
  }
}
