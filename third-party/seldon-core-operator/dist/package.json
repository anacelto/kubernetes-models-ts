{
  "name": "@kubernetes-models/seldon-core-operator",
  "version": "0.3.2",
  "description": "seldon core operator",
  "repository": {
    "type": "git",
    "url": "https://github.com/tommy351/kubernetes-models-ts.git"
  },
  "homepage": "https://github.com/tommy351/kubernetes-models-ts/tree/master/third-party/seldon-core-operator",
  "author": "chris Hsieh <chris@dcard.cc>",
  "license": "MIT",
  "main": "index.js",
  "module": "index.mjs",
  "types": "index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "crd-generate && publish-scripts build",
    "prepack": "publish-scripts prepack"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist",
    "linkDirectory": true
  },
  "keywords": [
    "kubernetes",
    "kubernetes-models",
    "seldon-core-operator"
  ],
  "engines": {
    "node": ">=14"
  },
  "dependencies": {
    "@kubernetes-models/apimachinery": "workspace:^",
    "@kubernetes-models/base": "workspace:^",
    "@kubernetes-models/validate": "workspace:^",
    "@swc/helpers": "^0.5.8"
  },
  "devDependencies": {
    "@kubernetes-models/crd-generate": "workspace:^",
    "@kubernetes-models/publish-scripts": "workspace:^",
    "vitest": "^0.29.8"
  },
  "crd-generate": {
    "input": [
      "https://raw.githubusercontent.com/SeldonIO/seldon-core/v1.15.0/operator/config/crd/bases/machinelearning.seldon.io_seldondeployments.yaml"
    ],
    "output": "./gen"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./machinelearning.seldon.io": {
      "types": "./machinelearning.seldon.io/index.d.ts",
      "import": "./machinelearning.seldon.io/index.mjs",
      "require": "./machinelearning.seldon.io/index.js"
    },
    "./machinelearning.seldon.io/v1": {
      "types": "./machinelearning.seldon.io/v1/index.d.ts",
      "import": "./machinelearning.seldon.io/v1/index.mjs",
      "require": "./machinelearning.seldon.io/v1/index.js"
    },
    "./machinelearning.seldon.io/v1/*": {
      "types": "./machinelearning.seldon.io/v1/*.d.ts",
      "import": "./machinelearning.seldon.io/v1/*.mjs",
      "require": "./machinelearning.seldon.io/v1/*.js"
    },
    "./machinelearning.seldon.io/v1alpha2": {
      "types": "./machinelearning.seldon.io/v1alpha2/index.d.ts",
      "import": "./machinelearning.seldon.io/v1alpha2/index.mjs",
      "require": "./machinelearning.seldon.io/v1alpha2/index.js"
    },
    "./machinelearning.seldon.io/v1alpha2/*": {
      "types": "./machinelearning.seldon.io/v1alpha2/*.d.ts",
      "import": "./machinelearning.seldon.io/v1alpha2/*.mjs",
      "require": "./machinelearning.seldon.io/v1alpha2/*.js"
    },
    "./machinelearning.seldon.io/v1alpha3": {
      "types": "./machinelearning.seldon.io/v1alpha3/index.d.ts",
      "import": "./machinelearning.seldon.io/v1alpha3/index.mjs",
      "require": "./machinelearning.seldon.io/v1alpha3/index.js"
    },
    "./machinelearning.seldon.io/v1alpha3/*": {
      "types": "./machinelearning.seldon.io/v1alpha3/*.d.ts",
      "import": "./machinelearning.seldon.io/v1alpha3/*.mjs",
      "require": "./machinelearning.seldon.io/v1alpha3/*.js"
    },
    "./package.json": "./package.json"
  }
}
