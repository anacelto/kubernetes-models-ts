    },
    "./serving.knative.dev/v1alpha1/*": {
      "types": "./serving.knative.dev/v1alpha1/*.d.ts",
      "import": "./serving.knative.dev/v1alpha1/*.mjs",
      "require": "./serving.knative.dev/v1alpha1/*.js"
    },
    "./serving.knative.dev/v1beta1": {
      "types": "./serving.knative.dev/v1beta1/index.d.ts",
      "import": "./serving.knative.dev/v1beta1/index.mjs",
      "require": "./serving.knative.dev/v1beta1/index.js"
    },
    "./serving.knative.dev/v1beta1/*": {
      "types": "./serving.knative.dev/v1beta1/*.d.ts",
      "import": "./serving.knative.dev/v1beta1/*.mjs",
      "require": "./serving.knative.dev/v1beta1/*.js"
    },
    "./sources.knative.dev": {
      "types": "./sources.knative.dev/index.d.ts",
      "import": "./sources.knative.dev/index.mjs",
      "require": "./sources.knative.dev/index.js"
    },
    "./sources.knative.dev/v1": {
      "types": "./sources.knative.dev/v1/index.d.ts",
      "import": "./sources.knative.dev/v1/index.mjs",
      "require": "./sources.knative.dev/v1/index.js"
    },
    "./sources.knative.dev/v1/*": {
      "types": "./sources.knative.dev/v1/*.d.ts",
      "import": "./sources.knative.dev/v1/*.mjs",
      "require": "./sources.knative.dev/v1/*.js"
    },
    "./sources.knative.dev/v1beta2": {
      "types": "./sources.knative.dev/v1beta2/index.d.ts",
      "import": "./sources.knative.dev/v1beta2/index.mjs",
      "require": "./sources.knative.dev/v1beta2/index.js"
    },
    "./sources.knative.dev/v1beta2/*": {
      "types": "./sources.knative.dev/v1beta2/*.d.ts",
