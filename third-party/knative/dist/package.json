      "types": "./flows.knative.dev/v1/index.d.ts",
      "import": "./flows.knative.dev/v1/index.mjs",
      "require": "./flows.knative.dev/v1/index.js"
    },
    "./flows.knative.dev/v1/*": {
      "types": "./flows.knative.dev/v1/*.d.ts",
      "import": "./flows.knative.dev/v1/*.mjs",
      "require": "./flows.knative.dev/v1/*.js"
    },
    "./messaging.knative.dev": {
      "types": "./messaging.knative.dev/index.d.ts",
      "import": "./messaging.knative.dev/index.mjs",
      "require": "./messaging.knative.dev/index.js"
    },
    "./messaging.knative.dev/v1": {
      "types": "./messaging.knative.dev/v1/index.d.ts",
      "import": "./messaging.knative.dev/v1/index.mjs",
      "require": "./messaging.knative.dev/v1/index.js"
    },
    "./messaging.knative.dev/v1/*": {
      "types": "./messaging.knative.dev/v1/*.d.ts",
      "import": "./messaging.knative.dev/v1/*.mjs",
      "require": "./messaging.knative.dev/v1/*.js"
    },
    "./networking.internal.knative.dev": {
      "types": "./networking.internal.knative.dev/index.d.ts",
      "import": "./networking.internal.knative.dev/index.mjs",
      "require": "./networking.internal.knative.dev/index.js"
    },
    "./networking.internal.knative.dev/v1alpha1": {
      "types": "./networking.internal.knative.dev/v1alpha1/index.d.ts",
      "import": "./networking.internal.knative.dev/v1alpha1/index.mjs",
      "require": "./networking.internal.knative.dev/v1alpha1/index.js"
    },
    "./networking.internal.knative.dev/v1alpha1/*": {
      "types": "./networking.internal.knative.dev/v1alpha1/*.d.ts",
      "import": "./networking.internal.knative.dev/v1alpha1/*.mjs",
      "require": "./networking.internal.knative.dev/v1alpha1/*.js"
    },
    "./operator.knative.dev": {
      "types": "./operator.knative.dev/index.d.ts",
      "import": "./operator.knative.dev/index.mjs",
      "require": "./operator.knative.dev/index.js"
    },
    "./operator.knative.dev/v1beta1": {
      "types": "./operator.knative.dev/v1beta1/index.d.ts",
      "import": "./operator.knative.dev/v1beta1/index.mjs",
      "require": "./operator.knative.dev/v1beta1/index.js"
    },
    "./operator.knative.dev/v1beta1/*": {
      "types": "./operator.knative.dev/v1beta1/*.d.ts",
      "import": "./operator.knative.dev/v1beta1/*.mjs",
      "require": "./operator.knative.dev/v1beta1/*.js"
    },
    "./package.json": "./package.json",
    "./serving.knative.dev": {
      "types": "./serving.knative.dev/index.d.ts",
      "import": "./serving.knative.dev/index.mjs",
      "require": "./serving.knative.dev/index.js"
    },
    "./serving.knative.dev/v1": {
      "types": "./serving.knative.dev/v1/index.d.ts",
      "import": "./serving.knative.dev/v1/index.mjs",
      "require": "./serving.knative.dev/v1/index.js"
    },
    "./serving.knative.dev/v1/*": {
      "types": "./serving.knative.dev/v1/*.d.ts",
      "import": "./serving.knative.dev/v1/*.mjs",
      "require": "./serving.knative.dev/v1/*.js"
    },
    "./serving.knative.dev/v1alpha1": {
      "types": "./serving.knative.dev/v1alpha1/index.d.ts",
      "import": "./serving.knative.dev/v1alpha1/index.mjs",
