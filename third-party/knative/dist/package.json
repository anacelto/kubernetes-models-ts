{
  "name": "@kubernetes-models/knative",
  "version": "2.4.2",
  "description": "Knative models",
  "repository": {
    "type": "git",
    "url": "https://github.com/tommy351/kubernetes-models-ts.git"
  },
  "homepage": "https://github.com/tommy351/kubernetes-models-ts/tree/master/third-party/knative",
  "author": "Tommy Chen <tommy351@gmail.com>",
  "license": "MIT",
  "main": "index.cjs",
  "module": "index.mjs",
  "types": "index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "crd-generate && publish-scripts build",
    "prepack": "publish-scripts prepack"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist",
    "linkDirectory": true
  },
  "keywords": [
    "kubernetes",
    "kubernetes-models",
    "knative"
  ],
  "engines": {
    "node": ">=14"
  },
  "dependencies": {
    "@kubernetes-models/apimachinery": "workspace:^",
    "@kubernetes-models/base": "workspace:^",
    "@kubernetes-models/validate": "workspace:^",
    "@swc/helpers": "^0.5.8"
  },
  "devDependencies": {
    "@kubernetes-models/crd-generate": "workspace:^",
    "@kubernetes-models/publish-scripts": "workspace:^",
    "vitest": "^0.29.8"
  },
  "crd-generate": {
    "input": [
      "https://github.com/knative/serving/releases/download/knative-v1.10.1/serving-crds.yaml",
      "https://github.com/knative/eventing/releases/download/knative-v1.10.0/eventing-crds.yaml",
      "https://github.com/knative/operator/releases/download/knative-v1.10.0/operator.yaml"
    ],
    "output": "./gen",
    "yamlVersion": "1.1"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./autoscaling.internal.knative.dev": {
      "types": "./autoscaling.internal.knative.dev/index.d.ts",
      "import": "./autoscaling.internal.knative.dev/index.mjs",
      "require": "./autoscaling.internal.knative.dev/index.js"
    },
    "./autoscaling.internal.knative.dev/v1alpha1": {
      "types": "./autoscaling.internal.knative.dev/v1alpha1/index.d.ts",
      "import": "./autoscaling.internal.knative.dev/v1alpha1/index.mjs",
      "require": "./autoscaling.internal.knative.dev/v1alpha1/index.js"
    },
    "./autoscaling.internal.knative.dev/v1alpha1/*": {
      "types": "./autoscaling.internal.knative.dev/v1alpha1/*.d.ts",
      "import": "./autoscaling.internal.knative.dev/v1alpha1/*.mjs",
      "require": "./autoscaling.internal.knative.dev/v1alpha1/*.js"
    },
    "./caching.internal.knative.dev": {
      "types": "./caching.internal.knative.dev/index.d.ts",
      "import": "./caching.internal.knative.dev/index.mjs",
      "require": "./caching.internal.knative.dev/index.js"
    },
    "./caching.internal.knative.dev/v1alpha1": {
      "types": "./caching.internal.knative.dev/v1alpha1/index.d.ts",
      "import": "./caching.internal.knative.dev/v1alpha1/index.mjs",
      "require": "./caching.internal.knative.dev/v1alpha1/index.js"
    },
    "./caching.internal.knative.dev/v1alpha1/*": {
      "types": "./caching.internal.knative.dev/v1alpha1/*.d.ts",
      "import": "./caching.internal.knative.dev/v1alpha1/*.mjs",
      "require": "./caching.internal.knative.dev/v1alpha1/*.js"
    },
    "./eventing.knative.dev": {
      "types": "./eventing.knative.dev/index.d.ts",
      "import": "./eventing.knative.dev/index.mjs",
      "require": "./eventing.knative.dev/index.js"
    },
    "./eventing.knative.dev/v1": {
      "types": "./eventing.knative.dev/v1/index.d.ts",
      "import": "./eventing.knative.dev/v1/index.mjs",
      "require": "./eventing.knative.dev/v1/index.js"
    },
    "./eventing.knative.dev/v1/*": {
      "types": "./eventing.knative.dev/v1/*.d.ts",
      "import": "./eventing.knative.dev/v1/*.mjs",
      "require": "./eventing.knative.dev/v1/*.js"
    },
    "./eventing.knative.dev/v1beta1": {
      "types": "./eventing.knative.dev/v1beta1/index.d.ts",
      "import": "./eventing.knative.dev/v1beta1/index.mjs",
      "require": "./eventing.knative.dev/v1beta1/index.js"
    },
    "./eventing.knative.dev/v1beta1/*": {
      "types": "./eventing.knative.dev/v1beta1/*.d.ts",
      "import": "./eventing.knative.dev/v1beta1/*.mjs",
      "require": "./eventing.knative.dev/v1beta1/*.js"
    },
    "./flows.knative.dev": {
