    },
    "./split.smi-spec.io/v1alpha1": {
      "types": "./split.smi-spec.io/v1alpha1/index.d.ts",
      "import": "./split.smi-spec.io/v1alpha1/index.mjs",
      "require": "./split.smi-spec.io/v1alpha1/index.js"
    },
    "./split.smi-spec.io/v1alpha1/*": {
      "types": "./split.smi-spec.io/v1alpha1/*.d.ts",
      "import": "./split.smi-spec.io/v1alpha1/*.mjs",
      "require": "./split.smi-spec.io/v1alpha1/*.js"
    },
    "./split.smi-spec.io/v1alpha2": {
      "types": "./split.smi-spec.io/v1alpha2/index.d.ts",
      "import": "./split.smi-spec.io/v1alpha2/index.mjs",
      "require": "./split.smi-spec.io/v1alpha2/index.js"
    },
    "./split.smi-spec.io/v1alpha2/*": {
      "types": "./split.smi-spec.io/v1alpha2/*.d.ts",
      "import": "./split.smi-spec.io/v1alpha2/*.mjs",
      "require": "./split.smi-spec.io/v1alpha2/*.js"
    },
    "./split.smi-spec.io/v1alpha3": {
      "types": "./split.smi-spec.io/v1alpha3/index.d.ts",
