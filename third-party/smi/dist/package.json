      "import": "./access.smi-spec.io/v1alpha4/*.mjs",
      "require": "./access.smi-spec.io/v1alpha4/*.js"
    },
    "./package.json": "./package.json",
    "./specs.smi-spec.io": {
      "types": "./specs.smi-spec.io/index.d.ts",
      "import": "./specs.smi-spec.io/index.mjs",
      "require": "./specs.smi-spec.io/index.js"
    },
    "./specs.smi-spec.io/v1alpha1": {
      "types": "./specs.smi-spec.io/v1alpha1/index.d.ts",
      "import": "./specs.smi-spec.io/v1alpha1/index.mjs",
      "require": "./specs.smi-spec.io/v1alpha1/index.js"
    },
    "./specs.smi-spec.io/v1alpha1/*": {
      "types": "./specs.smi-spec.io/v1alpha1/*.d.ts",
      "import": "./specs.smi-spec.io/v1alpha1/*.mjs",
      "require": "./specs.smi-spec.io/v1alpha1/*.js"
    },
    "./specs.smi-spec.io/v1alpha2": {
      "types": "./specs.smi-spec.io/v1alpha2/index.d.ts",
      "import": "./specs.smi-spec.io/v1alpha2/index.mjs",
      "require": "./specs.smi-spec.io/v1alpha2/index.js"
    },
    "./specs.smi-spec.io/v1alpha2/*": {
      "types": "./specs.smi-spec.io/v1alpha2/*.d.ts",
      "import": "./specs.smi-spec.io/v1alpha2/*.mjs",
      "require": "./specs.smi-spec.io/v1alpha2/*.js"
    },
    "./specs.smi-spec.io/v1alpha3": {
      "types": "./specs.smi-spec.io/v1alpha3/index.d.ts",
      "import": "./specs.smi-spec.io/v1alpha3/index.mjs",
      "require": "./specs.smi-spec.io/v1alpha3/index.js"
    },
    "./specs.smi-spec.io/v1alpha3/*": {
