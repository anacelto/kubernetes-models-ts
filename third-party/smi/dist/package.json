      "https://raw.githubusercontent.com/servicemeshinterface/smi-controller-sdk/4cbed06a67893f8220096ba09c1b4d52c0a2468d/config/crd/bases/split.smi-spec.io_trafficsplits.yaml"
    ],
    "output": "./gen"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./access.smi-spec.io": {
      "types": "./access.smi-spec.io/index.d.ts",
      "import": "./access.smi-spec.io/index.mjs",
      "require": "./access.smi-spec.io/index.js"
    },
    "./access.smi-spec.io/v1alpha1": {
      "types": "./access.smi-spec.io/v1alpha1/index.d.ts",
      "import": "./access.smi-spec.io/v1alpha1/index.mjs",
      "require": "./access.smi-spec.io/v1alpha1/index.js"
    },
    "./access.smi-spec.io/v1alpha1/*": {
      "types": "./access.smi-spec.io/v1alpha1/*.d.ts",
      "import": "./access.smi-spec.io/v1alpha1/*.mjs",
      "require": "./access.smi-spec.io/v1alpha1/*.js"
    },
    "./access.smi-spec.io/v1alpha2": {
      "types": "./access.smi-spec.io/v1alpha2/index.d.ts",
      "import": "./access.smi-spec.io/v1alpha2/index.mjs",
      "require": "./access.smi-spec.io/v1alpha2/index.js"
    },
    "./access.smi-spec.io/v1alpha2/*": {
      "types": "./access.smi-spec.io/v1alpha2/*.d.ts",
      "import": "./access.smi-spec.io/v1alpha2/*.mjs",
      "require": "./access.smi-spec.io/v1alpha2/*.js"
    },
