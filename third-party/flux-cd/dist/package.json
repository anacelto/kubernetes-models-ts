    "./source.toolkit.fluxcd.io": {
      "types": "./source.toolkit.fluxcd.io/index.d.ts",
      "import": "./source.toolkit.fluxcd.io/index.mjs",
      "require": "./source.toolkit.fluxcd.io/index.js"
    },
    "./source.toolkit.fluxcd.io/v1": {
