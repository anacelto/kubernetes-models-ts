    },
    "./kustomize.toolkit.fluxcd.io/v1beta1": {
      "types": "./kustomize.toolkit.fluxcd.io/v1beta1/index.d.ts",
      "import": "./kustomize.toolkit.fluxcd.io/v1beta1/index.mjs",
      "require": "./kustomize.toolkit.fluxcd.io/v1beta1/index.js"
    },
    "./kustomize.toolkit.fluxcd.io/v1beta1/*": {
      "types": "./kustomize.toolkit.fluxcd.io/v1beta1/*.d.ts",
