{
  "name": "@kubernetes-models/envoy-gateway",
  "version": "0.3.2",
  "description": "Envoy Gateway models",
  "repository": {
    "type": "git",
    "url": "https://github.com/tommy351/kubernetes-models-ts.git"
  },
  "homepage": "https://github.com/tommy351/kubernetes-models-ts/tree/master/third-party/envoy-gateway",
  "author": "Leo Zhan <leozhantw@gmail.com>",
  "license": "MIT",
  "main": "index.js",
  "module": "index.mjs",
  "types": "index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "ts-node scripts/download-crd.ts && crd-generate && publish-scripts build",
    "prepack": "publish-scripts prepack"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist",
    "linkDirectory": true
  },
  "keywords": [
    "kubernetes",
    "kubernetes-models",
    "envoy-gateway"
  ],
  "engines": {
    "node": ">=14"
  },
  "dependencies": {
    "@kubernetes-models/apimachinery": "workspace:^",
    "@kubernetes-models/base": "workspace:^",
    "@kubernetes-models/validate": "workspace:^",
    "@swc/helpers": "^0.5.8"
  },
  "devDependencies": {
    "@kubernetes-models/crd-generate": "workspace:^",
    "@kubernetes-models/publish-scripts": "workspace:^",
    "@kubernetes-models/read-input": "workspace:^",
    "@types/js-yaml": "^4.0.5",
    "@types/node": "^18.7.23",
    "js-yaml": "^4.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^4.8.4",
    "vitest": "^0.29.8"
  },
  "crd-generate": {
    "input": [
      "./crds/crd.yaml"
    ],
    "output": "./gen"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./config.gateway.envoyproxy.io": {
      "types": "./config.gateway.envoyproxy.io/index.d.ts",
      "import": "./config.gateway.envoyproxy.io/index.mjs",
      "require": "./config.gateway.envoyproxy.io/index.js"
    },
    "./config.gateway.envoyproxy.io/v1alpha1": {
      "types": "./config.gateway.envoyproxy.io/v1alpha1/index.d.ts",
      "import": "./config.gateway.envoyproxy.io/v1alpha1/index.mjs",
      "require": "./config.gateway.envoyproxy.io/v1alpha1/index.js"
    },
    "./config.gateway.envoyproxy.io/v1alpha1/*": {
      "types": "./config.gateway.envoyproxy.io/v1alpha1/*.d.ts",
      "import": "./config.gateway.envoyproxy.io/v1alpha1/*.mjs",
      "require": "./config.gateway.envoyproxy.io/v1alpha1/*.js"
    },
    "./gateway.envoyproxy.io": {
      "types": "./gateway.envoyproxy.io/index.d.ts",
      "import": "./gateway.envoyproxy.io/index.mjs",
      "require": "./gateway.envoyproxy.io/index.js"
    },
    "./gateway.envoyproxy.io/v1alpha1": {
      "types": "./gateway.envoyproxy.io/v1alpha1/index.d.ts",
      "import": "./gateway.envoyproxy.io/v1alpha1/index.mjs",
      "require": "./gateway.envoyproxy.io/v1alpha1/index.js"
    },
    "./gateway.envoyproxy.io/v1alpha1/*": {
      "types": "./gateway.envoyproxy.io/v1alpha1/*.d.ts",
      "import": "./gateway.envoyproxy.io/v1alpha1/*.mjs",
      "require": "./gateway.envoyproxy.io/v1alpha1/*.js"
    },
    "./package.json": "./package.json"
  }
}
