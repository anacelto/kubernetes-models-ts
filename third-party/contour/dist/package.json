{
  "name": "@kubernetes-models/contour",
  "version": "4.3.2",
  "description": "Contour models",
  "repository": {
    "type": "git",
    "url": "https://github.com/tommy351/kubernetes-models-ts.git"
  },
  "homepage": "https://github.com/tommy351/kubernetes-models-ts/tree/master/third-party/contour",
  "author": "Tommy Chen <tommy351@gmail.com>",
  "license": "MIT",
  "main": "index.js",
  "module": "index.mjs",
  "types": "index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "crd-generate && publish-scripts build",
    "prepack": "publish-scripts prepack"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist",
    "linkDirectory": true
  },
  "keywords": [
    "kubernetes",
    "kubernetes-models",
    "contour"
  ],
  "engines": {
    "node": ">=14"
  },
  "dependencies": {
    "@kubernetes-models/apimachinery": "workspace:^",
    "@kubernetes-models/base": "workspace:^",
    "@kubernetes-models/validate": "workspace:^",
    "@swc/helpers": "^0.5.8"
  },
  "devDependencies": {
    "@kubernetes-models/crd-generate": "workspace:^",
    "@kubernetes-models/publish-scripts": "workspace:^",
    "vitest": "^0.29.8"
  },
  "crd-generate": {
    "input": [
      "https://raw.githubusercontent.com/projectcontour/contour/v1.5.0/examples/contour/01-crds.yaml",
      "https://raw.githubusercontent.com/projectcontour/contour/v1.25.0/examples/contour/01-crds.yaml"
    ],
    "output": "./gen"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./contour.heptio.com": {
      "types": "./contour.heptio.com/index.d.ts",
      "import": "./contour.heptio.com/index.mjs",
      "require": "./contour.heptio.com/index.js"
    },
    "./contour.heptio.com/v1beta1": {
      "types": "./contour.heptio.com/v1beta1/index.d.ts",
      "import": "./contour.heptio.com/v1beta1/index.mjs",
      "require": "./contour.heptio.com/v1beta1/index.js"
    },
    "./contour.heptio.com/v1beta1/*": {
      "types": "./contour.heptio.com/v1beta1/*.d.ts",
      "import": "./contour.heptio.com/v1beta1/*.mjs",
      "require": "./contour.heptio.com/v1beta1/*.js"
    },
    "./package.json": "./package.json",
    "./projectcontour.io": {
      "types": "./projectcontour.io/index.d.ts",
      "import": "./projectcontour.io/index.mjs",
      "require": "./projectcontour.io/index.js"
    },
    "./projectcontour.io/v1": {
      "types": "./projectcontour.io/v1/index.d.ts",
      "import": "./projectcontour.io/v1/index.mjs",
      "require": "./projectcontour.io/v1/index.js"
    },
    "./projectcontour.io/v1/*": {
      "types": "./projectcontour.io/v1/*.d.ts",
      "import": "./projectcontour.io/v1/*.mjs",
      "require": "./projectcontour.io/v1/*.js"
    },
    "./projectcontour.io/v1alpha1": {
      "types": "./projectcontour.io/v1alpha1/index.d.ts",
      "import": "./projectcontour.io/v1alpha1/index.mjs",
      "require": "./projectcontour.io/v1alpha1/index.js"
    },
    "./projectcontour.io/v1alpha1/*": {
      "types": "./projectcontour.io/v1alpha1/*.d.ts",
      "import": "./projectcontour.io/v1alpha1/*.mjs",
      "require": "./projectcontour.io/v1alpha1/*.js"
    }
  }
}
