{
  "name": "@kubernetes-models/kyverno",
  "version": "0.3.2",
  "description": "Kyverno models",
  "repository": {
    "type": "git",
    "url": "https://github.com/tommy351/kubernetes-models-ts.git"
  },
  "homepage": "https://github.com/tommy351/kubernetes-models-ts/tree/master/third-party/kyverno",
  "author": "benjamin99 <cknomber1@gmail.com>",
  "license": "MIT",
  "main": "index.js",
  "module": "index.mjs",
  "types": "index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "crd-generate && publish-scripts build",
    "prepack": "publish-scripts prepack"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist",
    "linkDirectory": true
  },
  "keywords": [
    "kubernetes",
    "kubernetes-models",
    "kyverno"
  ],
  "engines": {
    "node": ">=14"
  },
  "dependencies": {
    "@kubernetes-models/apimachinery": "workspace:^",
    "@kubernetes-models/base": "workspace:^",
    "@kubernetes-models/validate": "workspace:^",
    "@swc/helpers": "^0.5.8"
  },
  "devDependencies": {
    "@kubernetes-models/crd-generate": "workspace:^",
    "@kubernetes-models/publish-scripts": "workspace:^",
    "vitest": "^0.29.8"
  },
  "crd-generate": {
    "input": [
      "https://github.com/kyverno/kyverno/releases/download/v1.14.0/install.yaml"
    ],
    "output": "./gen"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./kyverno.io": {
      "types": "./kyverno.io/index.d.ts",
      "import": "./kyverno.io/index.mjs",
      "require": "./kyverno.io/index.js"
    },
    "./kyverno.io/v1": {
      "types": "./kyverno.io/v1/index.d.ts",
      "import": "./kyverno.io/v1/index.mjs",
      "require": "./kyverno.io/v1/index.js"
    },
    "./kyverno.io/v1/*": {
      "types": "./kyverno.io/v1/*.d.ts",
      "import": "./kyverno.io/v1/*.mjs",
      "require": "./kyverno.io/v1/*.js"
    },
    "./kyverno.io/v1alpha2": {
      "types": "./kyverno.io/v1alpha2/index.d.ts",
      "import": "./kyverno.io/v1alpha2/index.mjs",
      "require": "./kyverno.io/v1alpha2/index.js"
    },
    "./kyverno.io/v1alpha2/*": {
      "types": "./kyverno.io/v1alpha2/*.d.ts",
      "import": "./kyverno.io/v1alpha2/*.mjs",
      "require": "./kyverno.io/v1alpha2/*.js"
    },
    "./kyverno.io/v1beta1": {
      "types": "./kyverno.io/v1beta1/index.d.ts",
      "import": "./kyverno.io/v1beta1/index.mjs",
      "require": "./kyverno.io/v1beta1/index.js"
    },
    "./kyverno.io/v1beta1/*": {
      "types": "./kyverno.io/v1beta1/*.d.ts",
      "import": "./kyverno.io/v1beta1/*.mjs",
      "require": "./kyverno.io/v1beta1/*.js"
    },
    "./kyverno.io/v2": {
      "types": "./kyverno.io/v2/index.d.ts",
      "import": "./kyverno.io/v2/index.mjs",
      "require": "./kyverno.io/v2/index.js"
    },
    "./kyverno.io/v2/*": {
      "types": "./kyverno.io/v2/*.d.ts",
      "import": "./kyverno.io/v2/*.mjs",
      "require": "./kyverno.io/v2/*.js"
    },
    "./kyverno.io/v2alpha1": {
      "types": "./kyverno.io/v2alpha1/index.d.ts",
      "import": "./kyverno.io/v2alpha1/index.mjs",
      "require": "./kyverno.io/v2alpha1/index.js"
    },
    "./kyverno.io/v2alpha1/*": {
      "types": "./kyverno.io/v2alpha1/*.d.ts",
      "import": "./kyverno.io/v2alpha1/*.mjs",
      "require": "./kyverno.io/v2alpha1/*.js"
    },
    "./kyverno.io/v2beta1": {
      "types": "./kyverno.io/v2beta1/index.d.ts",
      "import": "./kyverno.io/v2beta1/index.mjs",
      "require": "./kyverno.io/v2beta1/index.js"
    },
    "./kyverno.io/v2beta1/*": {
      "types": "./kyverno.io/v2beta1/*.d.ts",
      "import": "./kyverno.io/v2beta1/*.mjs",
      "require": "./kyverno.io/v2beta1/*.js"
    },
    "./package.json": "./package.json",
    "./policies.kyverno.io": {
      "types": "./policies.kyverno.io/index.d.ts",
      "import": "./policies.kyverno.io/index.mjs",
      "require": "./policies.kyverno.io/index.js"
    },
    "./policies.kyverno.io/v1alpha1": {
      "types": "./policies.kyverno.io/v1alpha1/index.d.ts",
      "import": "./policies.kyverno.io/v1alpha1/index.mjs",
      "require": "./policies.kyverno.io/v1alpha1/index.js"
    },
    "./policies.kyverno.io/v1alpha1/*": {
      "types": "./policies.kyverno.io/v1alpha1/*.d.ts",
      "import": "./policies.kyverno.io/v1alpha1/*.mjs",
      "require": "./policies.kyverno.io/v1alpha1/*.js"
    },
    "./reports.kyverno.io": {
      "types": "./reports.kyverno.io/index.d.ts",
      "import": "./reports.kyverno.io/index.mjs",
      "require": "./reports.kyverno.io/index.js"
    },
    "./reports.kyverno.io/v1": {
      "types": "./reports.kyverno.io/v1/index.d.ts",
      "import": "./reports.kyverno.io/v1/index.mjs",
      "require": "./reports.kyverno.io/v1/index.js"
    },
    "./reports.kyverno.io/v1/*": {
      "types": "./reports.kyverno.io/v1/*.d.ts",
      "import": "./reports.kyverno.io/v1/*.mjs",
      "require": "./reports.kyverno.io/v1/*.js"
    },
    "./wgpolicyk8s.io": {
      "types": "./wgpolicyk8s.io/index.d.ts",
      "import": "./wgpolicyk8s.io/index.mjs",
      "require": "./wgpolicyk8s.io/index.js"
    },
    "./wgpolicyk8s.io/v1alpha2": {
      "types": "./wgpolicyk8s.io/v1alpha2/index.d.ts",
      "import": "./wgpolicyk8s.io/v1alpha2/index.mjs",
      "require": "./wgpolicyk8s.io/v1alpha2/index.js"
    },
    "./wgpolicyk8s.io/v1alpha2/*": {
      "types": "./wgpolicyk8s.io/v1alpha2/*.d.ts",
      "import": "./wgpolicyk8s.io/v1alpha2/*.mjs",
      "require": "./wgpolicyk8s.io/v1alpha2/*.js"
    }
  }
}
