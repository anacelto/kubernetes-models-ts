{
  "name": "@kubernetes-models/istio",
  "version": "2.4.2",
  "description": "Istio models",
  "repository": {
    "type": "git",
    "url": "https://github.com/tommy351/kubernetes-models-ts.git"
  },
  "homepage": "https://github.com/tommy351/kubernetes-models-ts/tree/master/third-party/istio",
  "author": "Tommy Chen <tommy351@gmail.com>",
  "license": "MIT",
  "main": "index.cjs",
  "module": "index.mjs",
  "types": "index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "crd-generate && publish-scripts build",
    "prepack": "publish-scripts prepack"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist",
    "linkDirectory": true
  },
  "keywords": [
    "kubernetes",
    "kubernetes-models",
    "istio"
  ],
  "engines": {
    "node": ">=14"
  },
  "dependencies": {
    "@kubernetes-models/apimachinery": "workspace:^",
    "@kubernetes-models/base": "workspace:^",
    "@kubernetes-models/validate": "workspace:^",
    "@swc/helpers": "^0.5.8"
  },
  "devDependencies": {
    "@kubernetes-models/crd-generate": "workspace:^",
    "@kubernetes-models/publish-scripts": "workspace:^",
    "vitest": "^0.29.8"
  },
  "crd-generate": {
    "input": [
      "https://raw.githubusercontent.com/istio/istio/1.18.0/manifests/charts/base/crds/crd-all.gen.yaml",
      "https://raw.githubusercontent.com/istio/istio/1.18.0/manifests/charts/base/crds/crd-operator.yaml"
    ],
    "output": "./gen"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./extensions.istio.io": {
      "types": "./extensions.istio.io/index.d.ts",
      "import": "./extensions.istio.io/index.mjs",
      "require": "./extensions.istio.io/index.js"
    },
    "./extensions.istio.io/v1alpha1": {
      "types": "./extensions.istio.io/v1alpha1/index.d.ts",
      "import": "./extensions.istio.io/v1alpha1/index.mjs",
      "require": "./extensions.istio.io/v1alpha1/index.js"
    },
    "./extensions.istio.io/v1alpha1/*": {
      "types": "./extensions.istio.io/v1alpha1/*.d.ts",
      "import": "./extensions.istio.io/v1alpha1/*.mjs",
      "require": "./extensions.istio.io/v1alpha1/*.js"
    },
    "./install.istio.io": {
      "types": "./install.istio.io/index.d.ts",
      "import": "./install.istio.io/index.mjs",
      "require": "./install.istio.io/index.js"
    },
    "./install.istio.io/v1alpha1": {
      "types": "./install.istio.io/v1alpha1/index.d.ts",
      "import": "./install.istio.io/v1alpha1/index.mjs",
      "require": "./install.istio.io/v1alpha1/index.js"
    },
    "./install.istio.io/v1alpha1/*": {
      "types": "./install.istio.io/v1alpha1/*.d.ts",
      "import": "./install.istio.io/v1alpha1/*.mjs",
      "require": "./install.istio.io/v1alpha1/*.js"
    },
    "./networking.istio.io": {
      "types": "./networking.istio.io/index.d.ts",
      "import": "./networking.istio.io/index.mjs",
      "require": "./networking.istio.io/index.js"
    },
    "./networking.istio.io/v1alpha3": {
      "types": "./networking.istio.io/v1alpha3/index.d.ts",
      "import": "./networking.istio.io/v1alpha3/index.mjs",
      "require": "./networking.istio.io/v1alpha3/index.js"
    },
    "./networking.istio.io/v1alpha3/*": {
      "types": "./networking.istio.io/v1alpha3/*.d.ts",
      "import": "./networking.istio.io/v1alpha3/*.mjs",
      "require": "./networking.istio.io/v1alpha3/*.js"
    },
    "./networking.istio.io/v1beta1": {
      "types": "./networking.istio.io/v1beta1/index.d.ts",
      "import": "./networking.istio.io/v1beta1/index.mjs",
      "require": "./networking.istio.io/v1beta1/index.js"
    },
    "./networking.istio.io/v1beta1/*": {
      "types": "./networking.istio.io/v1beta1/*.d.ts",
      "import": "./networking.istio.io/v1beta1/*.mjs",
      "require": "./networking.istio.io/v1beta1/*.js"
    },
    "./package.json": "./package.json",
    "./security.istio.io": {
      "types": "./security.istio.io/index.d.ts",
      "import": "./security.istio.io/index.mjs",
      "require": "./security.istio.io/index.js"
    },
    "./security.istio.io/v1": {
      "types": "./security.istio.io/v1/index.d.ts",
      "import": "./security.istio.io/v1/index.mjs",
      "require": "./security.istio.io/v1/index.js"
    },
    "./security.istio.io/v1/*": {
      "types": "./security.istio.io/v1/*.d.ts",
      "import": "./security.istio.io/v1/*.mjs",
      "require": "./security.istio.io/v1/*.js"
    },
    "./security.istio.io/v1beta1": {
      "types": "./security.istio.io/v1beta1/index.d.ts",
      "import": "./security.istio.io/v1beta1/index.mjs",
      "require": "./security.istio.io/v1beta1/index.js"
    },
    "./security.istio.io/v1beta1/*": {
      "types": "./security.istio.io/v1beta1/*.d.ts",
      "import": "./security.istio.io/v1beta1/*.mjs",
      "require": "./security.istio.io/v1beta1/*.js"
    },
    "./telemetry.istio.io": {
      "types": "./telemetry.istio.io/index.d.ts",
      "import": "./telemetry.istio.io/index.mjs",
      "require": "./telemetry.istio.io/index.js"
    },
    "./telemetry.istio.io/v1alpha1": {
      "types": "./telemetry.istio.io/v1alpha1/index.d.ts",
      "import": "./telemetry.istio.io/v1alpha1/index.mjs",
      "require": "./telemetry.istio.io/v1alpha1/index.js"
    },
    "./telemetry.istio.io/v1alpha1/*": {
      "types": "./telemetry.istio.io/v1alpha1/*.d.ts",
      "import": "./telemetry.istio.io/v1alpha1/*.mjs",
      "require": "./telemetry.istio.io/v1alpha1/*.js"
    }
  }
}
